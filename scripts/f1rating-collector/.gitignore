.venv/
cache/
__pycache__/
.pytest_cache/

# Regenerable calibration-run output — has a live `generatedAt` timestamp and drifts every time
# `npm run f1rating:calibrate` runs, so it is not a stable, reproducible artifact worth committing.
# The 5 recorded real-data inputs above it (2025_*.json) ARE committed — they're what makes the
# report reproducible on demand; the report itself is not meant to be a persisted fixture.
output/calibration-report.json
output/collection-summary-*.json

# Full-grid raw exports (9 rounds x ~20 drivers, ~3.7MB of lap-by-lap telemetry) — too large to
# treat as a "small recorded input" the way the 5 McLaren-only files above are. Regenerable on
# demand via `batch_collect.py --season 2025 --rounds 1,4,7,10,13,16,19,22,24`.
#
# What DOES get committed from this run: the dataset manifest (deterministic content modulo its
# own `generatedAt` stamp — same pattern as any manifest) and the v2-candidate methodology
# proposal — the two genuinely compact, valuable artifacts. The full `grid-calibration-report.json`
# (outlier audit + per-driver coverage, ~30KB, same live-`generatedAt` instability as
# `output/calibration-report.json` above) stays local/regenerable, not committed.
output_grid/*
!output_grid/reports/
output_grid/reports/*
!output_grid/reports/manifest.json
!output_grid/reports/v2-candidate-proposal.json

# Full-season (24/24 round) grid export — same rationale as output_grid/ above, scaled up.
# Committed: manifest (dataset provenance), the RAW (ungated) v2-candidate-proposal from the
# 24-round run alone, and stability-report.json (9-round-vs-24-round comparison + the
# STABILITY-GATED v2-candidate that actually supersedes the ungated one — see
# cli/stabilityReport.ts). grid-calibration-report.json stays local (live `generatedAt`, ~30KB
# outlier/coverage dump, regenerable via `npm run f1rating:grid-calibrate`).
output_grid_full/*
!output_grid_full/reports/
output_grid_full/reports/*
!output_grid_full/reports/manifest.json
!output_grid_full/reports/v2-candidate-proposal.json
!output_grid_full/reports/stability-report.json
# Multi-season (2023/2024 vs 2025) cross-season stability comparisons — the actual
# multi-season-validation deliverable (see cli/stabilityReport.ts), kept alongside the
# within-2025 9-vs-24-round comparison above for the same reason: compact, valuable, reproducible.
!output_grid_full/reports/stability-report-2023-vs-2025.json
!output_grid_full/reports/stability-report-2024-vs-2025.json
!output_grid_full/reports/stability-report-2023-vs-2024.json

# 9-round subset copied out of output_grid_full/ purely to feed the stability comparison above —
# not a distinct dataset, fully regenerable by re-copying those 9 files, never committed.
output_grid_subset9/

# Multi-season validation (2023/2024, alongside the 2025 output_grid_full/ above) — same
# rationale: raw per-round exports stay local/regenerable, only manifest + authoritative
# stability-report.json (once produced) are compact enough to commit as provenance.
output_grid_2023/*
!output_grid_2023/reports/
output_grid_2023/reports/*
!output_grid_2023/reports/manifest.json
!output_grid_2023/reports/v2-candidate-proposal.json
!output_grid_2023/reports/stability-report.json

output_grid_2024/*
!output_grid_2024/reports/
output_grid_2024/reports/*
!output_grid_2024/reports/manifest.json
!output_grid_2024/reports/v2-candidate-proposal.json
!output_grid_2024/reports/stability-report.json

